HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Used by the "Suggest SEO" and "Generate Page with AI" document actions (src/plugins/seo-suggestions) to call OpenAI.
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset.
OPENAI_MODEL=
# Optional, used only when "Generate a hero image with AI" is checked. Defaults to gpt-image-1.
OPENAI_IMAGE_MODEL=
# Optional. The FINAL image size as WIDTHxHEIGHT, any dimensions (e.g. 1440x400) — OpenAI only
# generates fixed sizes, so the server generates at the closest supported size for the target's
# orientation, then center-crops/resizes down to exactly this. Defaults to 1536x1024 if unset.
OPENAI_IMAGE_SIZE=

# SMTP settings for the email plugin (config/plugins.js), used to send the page-review
# notification email below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=

# Recipient notified by email whenever a page's workflowStatus is moved to "Review" (src/index.js).
REVIEW_NOTIFICATION_EMAIL=
