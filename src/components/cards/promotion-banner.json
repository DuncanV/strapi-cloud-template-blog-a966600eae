{
  "collectionName": "components_cards_promotion_banners",
  "info": {
    "displayName": "Promotion Banner",
    "description": "Reusable campaign or supporting-product block"
  },
  "options": {},
  "attributes": {
    "heading": { "type": "string", "required": true, "maxLength": 120 },
    "description": { "type": "text", "required": true },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "imageAltText": { "type": "string", "maxLength": 160 },
    "cta": { "type": "component", "component": "shared.cta", "repeatable": false },
    "theme": {
      "type": "enumeration",
      "enum": ["light", "dark", "brand"],
      "default": "light"
    },
    "enabled": { "type": "boolean", "default": true }
  }
}

