{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "description": "Search and social sharing metadata"
  },
  "options": {},
  "attributes": {
    "metaTitle": { "type": "string", "required": true, "maxLength": 60 },
    "metaDescription": { "type": "text", "required": true, "maxLength": 160 },
    "canonicalUrl": { "type": "string", "maxLength": 2048 },
    "shareImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "noIndex": { "type": "boolean", "default": false },
    "structuredData": { "type": "json" }
  }
}

