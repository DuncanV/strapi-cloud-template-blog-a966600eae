{
  "kind": "collectionType",
  "collectionName": "card_products",
  "info": {
    "singularName": "card-product",
    "pluralName": "card-products",
    "displayName": "Card Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "productName": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "required": true
    },
    "productCode": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAltText": {
      "type": "string",
      "required": true
    },
    "monthlyFee": {
      "type": "string"
    },
    "accountType": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "primaryCta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "secondaryCta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    }
  }
}
